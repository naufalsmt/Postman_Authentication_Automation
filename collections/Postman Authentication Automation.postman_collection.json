{
  "info": {
    "_postman_id": "9c9de772-6740-469b-89e6-3addd8b94d9b",
    "name": "Postman Authentication Automation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "38977457"
  },
  "item": [
    {
      "name": "01 - API Key Authentication.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\r\n    \"Status code is 200\",\r\n    function () {\r\n    pm.response.to.have.status(200);\r\n}\r\n);\r\n\r\npm.test(\"API key header was received\", function () {\r\n    const response = pm.response.json();\r\n    const property =\"x-api-key\"\r\n    const value = \"demo-api-key-123\"\r\n\r\n    pm.expect(response.headers).to.have.property(property);\r\n    pm.expect(response.headers[property]).to.eql(value);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{api_key}}"
          }
        ],
        "url": {
          "raw": "https://postman-echo.com/headers",
          "protocol": "https",
          "host": [
            "postman-echo",
            "com"
          ],
          "path": [
            "headers"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 - Basic Authentication - Positive",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\r\n    \"Check if the response status code is 200\",\r\n    function () {\r\n        pm.response.to.have.status(200);\r\n    }\r\n);\r\n\r\npm.test(\r\n    \"Check if the response is authenticated\",\r\n    function () {\r\n        const response = pm.response.json();\r\n        pm.expect(response.authenticated).to.be.true;\r\n    }\r\n);\r\n"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "postman",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{valid_token_pwd}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://postman-echo.com/basic-auth",
          "protocol": "https",
          "host": [
            "postman-echo",
            "com"
          ],
          "path": [
            "basic-auth"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 - Basic Authentication - Negative",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\r\n    \"Check if the response status code is 401\",\r\n    function () {\r\n        pm.response.to.have.status(401);\r\n    }\r\n)\r\n\r\npm.test(\r\n    \"Check if the response is Unauthorized\",\r\n    function () {\r\n        pm.expect(pm.response.text()).to.include(\"Unauthorized\")\r\n        }\r\n)"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "postman",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{invalid_token_pwd}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://postman-echo.com/basic-auth",
          "protocol": "https",
          "host": [
            "postman-echo",
            "com"
          ],
          "path": [
            "basic-auth"
          ]
        }
      },
      "response": []
    },
    {
      "name": "04 - Bearer Token Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\r\n    \"Status code is 200\",\r\n    function () {\r\n        pm.response.to.have.status(200);\r\n    }\r\n)\r\n\r\npm.test(\r\n    \"Access Token is present\",\r\n    function () {\r\n        const response = pm.response.json();\r\n        pm.expect(response.accessToken).to.exist;\r\n        pm.environment.set(\"access_token\", response.accessToken);\r\n    }\r\n)"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"emilys\",\r\n    \"password\": \"{{login_password}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://dummyjson.com/auth/login",
          "protocol": "https",
          "host": [
            "dummyjson",
            "com"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "05 - Get Authenticated User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Authenticated user details are received\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response).to.have.property(\"id\");\r\n    pm.expect(response).to.have.property(\"username\");\r\n    pm.expect(response.username).to.eql(\"emilys\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://dummyjson.com/auth/me",
          "protocol": "https",
          "host": [
            "dummyjson",
            "com"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      },
      "response": []
    },
    {
      "name": "06 - Get Authenticated User - Negative",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\r\n    \"Status code is 401\",\r\n    function () {\r\n        pm.response.to.have.status(401);\r\n    }\r\n)\r\n\r\npm.test(\r\n    \"Response body contains 'Access Token is required'\",\r\n    function () {\r\n        pm.expect(pm.response.text()).to.include(\"Access Token is required\");\r\n    }\r\n)"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cookieJar = pm.cookies.jar();\r\n\r\ntry {\r\n    await cookieJar.clear(\"https://dummyjson.com\");\r\n\r\n    console.log(\"DummyJSON cookies cleared successfully\");\r\n\r\n} catch (error) {\r\n    console.error(\"Cookie clearing failed:\", error);\r\n}"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disabledSystemHeaders": {}
      },
      "request": {
        "auth": {
          "type": "bearer"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://dummyjson.com/auth/me",
          "protocol": "https",
          "host": [
            "dummyjson",
            "com"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      },
      "response": []
    }
  ]
